# StructSense AI Environment Variables
# Copy this file to .env and fill in your values

# Groq API key for the AI Verdict (free at https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: path to the tesseract binary if it is not on PATH (needed only for scanned PDFs)
# TESSERACT_CMD=/opt/anaconda3/envs/tesseract/bin/tesseract

# Optional: Groq chat model (default openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b
